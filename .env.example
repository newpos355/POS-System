# Used by docker-compose.yml. Copy to `.env` in this same directory (that
# filename is gitignored) and fill in real values — never commit the real .env.
MONGO_DB_URL=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/pos_platform?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_value_never_reuse_an_example_secret
JWT_EXPIRE=7d
FRONTEND_URL=http://localhost:80
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
