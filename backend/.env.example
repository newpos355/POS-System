# ========================================================
# APEX POS - PRODUCTION ENVIRONMENT CONFIGURATION (.env)
# ========================================================

# Server Mode & Port
NODE_ENV=development
PORT=5000

# MongoDB Database Connection String (Use MongoDB Atlas for Cloud / Hostinger)
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/pos_db?retryWrites=true&w=majority
MONGO_DB_URL=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/pos_platform?retryWrites=true&w=majority

# JWT Authentication Secret Key & Expiration (Generate a strong random string)
JWT_SECRET=super_secret_jwt_key_please_change_in_production_2026
JWT_EXPIRE=30d

# Super Admin Initial Credentials (Used when running seeder)
SUPERADMIN_EMAIL=superadmin@posplatform.com
SUPERADMIN_PASSWORD=SuperAdmin123!

# Frontend Public URL (Your production domain)
FRONTEND_URL=https://yourdomain.com
BACKEND_PUBLIC_URL=https://yourdomain.com

# CORS allowlist — comma-separated origins allowed to call this API with
# credentials. Defaults to FRONTEND_URL if unset. Only needed if the frontend
# is served from more than one domain (e.g. a staging URL + production URL).
# CORS_ORIGINS=https://yourdomain.com,https://staging.yourdomain.com

# Cloudinary (Optional: For product image uploads to cloud)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Stripe Payments (Optional: For SaaS subscription billing)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Pesapal Payment Gateway (Optional)
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_BASE_URL=https://pay.pesapal.com/v3
PESAPAL_CALLBACK_URL=https://yourdomain.com/pos
PESAPAL_IPN_ID=

# Airtel / MTN Mobile Money (Optional)
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
MTN_SUBSCRIPTION_KEY=
MTN_API_USER=
MTN_API_KEY=
MTN_ENV=sandbox
