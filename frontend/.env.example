# ========================================================
# APEX POS - FRONTEND PRODUCTION CONFIGURATION (.env)
# ========================================================

# If frontend and backend are deployed together on the same domain (Single Server Mode),
# you can leave VITE_API_URL empty or set to /api
# If backend is on a separate domain/subdomain, specify full URL:
# VITE_API_URL=https://api.yourdomain.com/api
VITE_API_URL=/api
